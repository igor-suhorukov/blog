---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  The feed registered on Planet PostgreSQL. Its policy asks for a feed that
  holds only English posts about PostgreSQL, so this one takes only posts
  tagged "postgresql"; /feed.xml from jekyll-feed carries everything.
{%- endcomment -%}
{%- assign posts = site.posts | where_exp: "post", "post.tags contains 'postgresql'" %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author | xml_escape }}</name>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
  {%- for post in posts limit: 20 %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.id | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <author>
      <name>{{ post.author | default: site.author | xml_escape }}</name>
    </author>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
