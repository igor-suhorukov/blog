  "https://example.org/story-kg/id/habr-1097022/proc_lazy_scan.t1" [shape=box, style="rounded,filled", fillcolor="#f3e8fd", color="#8430ce", penwidth=1.5, margin="0.15,0.08", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD>⚙ Ask the data source<BR/>for the columns of the<BR/>first condition</TD></TR></TABLE>>];
  "https://example.org/story-kg/id/habr-1097022/proc_lazy_scan.t2" [shape=box, style="rounded,filled", fillcolor="#f3e8fd", color="#8430ce", penwidth=1.5, margin="0.15,0.08", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD>⚙ Apply the first<BR/>condition to the batch</TD></TR></TABLE>>];
