  "https://example.org/story-kg/id/habr-1097022/proc_lazy_scan.t4" [shape=box, style="rounded,filled", fillcolor="#f3e8fd", color="#8430ce", penwidth=1.5, margin="0.15,0.08", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1"><TR><TD>⚙ Do not read the<BR/>remaining columns of the<BR/>batch</TD></TR></TABLE>>];
