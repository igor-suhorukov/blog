digraph process {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, labelloc=t, nodesep=0.5, ranksep=0.45, pad=0.3, forcelabels=true, bgcolor="white", label="A scan that reads the remaining columns after the first condition"];
  node [fontname="DejaVu Sans", fontsize=12, fontcolor="#202124"];
